<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="tachiyomi.extension"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}">

        <meta-data
            android:name="tachiyomi.extension.class"
            android:value="${extClass}" />

        <meta-data
            android:name="tachiyomix.name"
            android:value="${appName}" />

        <meta-data
            android:name="tachiyomix.contentWarning"
            android:value="${contentWarning}" />

        <meta-data
            android:name="tachiyomix.extensionLib"
            android:value="${extensionLib}" />

    </application>

</manifest>
